# ==============================================================================
# Database Config
# ==============================================================================
# Format django-environ : postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# Le host est "db" car c'est le nom du service dans docker-compose.yml
# Le port interne du conteneur PostgreSQL est 5432 (pas 5433 qui est le port mappé sur l'hôte)
DATABASE_URL=postgres://jangubi_user:jangubi_pass@db:5432/jangubi

# Redis : utilisé pour le cache Django (django-redis)
REDIS_URL=redis://redis:6379/1

# ==============================================================================
# Django Config + Traefik Reverse Proxy
# ==============================================================================
APP_DOMAIN=https://jangubi.thenexcom.com
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.django.production
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
ALLOWED_HOSTS=jangubi.thenexcom.com,django,localhost
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Clé de chiffrement des conversations pastorales (Fernet, apps/messaging).
# OBLIGATOIRE en production : le settings refuse de démarrer sans elle.
# Elle DOIT être distincte de SECRET_KEY et ne JAMAIS être rotée une fois des
# messages écrits — sans elle, tout l'historique chiffré devient définitivement
# illisible. La garder hors de toute rotation de secrets, et la sauvegarder.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
MESSAGING_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_DEDICATED_KEY_NEVER_ROTATE

# Nombre de proxys de confiance devant l'app (Traefik seul = 1). Détermine
# l'adresse retenue pour le rate limiting : une valeur fausse rend le quota de
# login soit contournable, soit appliqué au proxy au lieu du client.
NUM_PROXIES=1

# Traefik reverse proxy en HTTP (MVP); passe à True une fois HTTPS opérationnel
SECURE_SSL_REDIRECT=True

# HSTS : rampe de sécurité. 3600 = 1 heure, valeur d'amorçage sans risque.
# Une fois TLS confirmé stable (certificat renouvelé au moins une fois),
# passer à 31536000 (1 an). N'activer includeSubDomains/preload QUE si TOUS
# les sous-domaines sont en HTTPS — l'engagement est difficile à annuler.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRAEFIK_ACME_EMAIL=admin@jangubi.thenexcom.com

# CORS.
#
# ⚠️ NE JAMAIS mettre True : combiné à CORS_ALLOW_CREDENTIALS (activé, requis par
# le cookie de refresh), django-cors-headers renvoie l'origine reçue au lieu de
# `*` — n'importe quel site pourrait alors émettre des requêtes AUTHENTIFIÉES
# vers l'API. C'était le réglage en place ; il a été corrigé.
CORS_ALLOW_ALL_ORIGINS=False

# ⚠️ C'est CE réglage que la bibliothèque lit. `DJANGO_CORS_ORIGIN_WHITELIST`
# plus bas est conservé pour compatibilité mais n'est PAS consulté directement
# (il ne sert que de repli si celui-ci est absent).
#
# Origines EXACTES, schéma compris, séparées par des virgules. Pas de joker :
# `https://*.vercel.app` n'est pas une origine valide et serait ignoré — pour un
# motif, utiliser CORS_ALLOWED_ORIGIN_REGEXES.
#
# Depuis le passage du refresh token en cookie, une origine manquante ne produit
# AUCUNE erreur serveur : la connexion échoue silencieusement dans le navigateur.
# À vérifier en priorité si « personne n'arrive à rester connecté ».
CORS_ALLOWED_ORIGINS=https://jangubi.thenexcom.com
DJANGO_CORS_ORIGIN_WHITELIST=https://jangubi.thenexcom.com
# Motifs d'origines (previews Vercel, etc.) — complète la liste exacte ci-dessus.
CORS_ALLOWED_ORIGIN_REGEXES=^https:\/\/[a-zA-Z0-9-]+\.vercel\.app$
# Requis pour les requêtes unsafe (POST/PUT/DELETE) côté web avec CSRF/session via Traefik
CSRF_TRUSTED_ORIGINS=https://jangubi.thenexcom.com,https://*.vercel.app
# Celery Broker : RabbitMQ (nom du service docker-compose)
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# URLs de base (utilisées par cors.py)
DJANGO_BASE_BACKEND_URL=https://jangubi.thenexcom.com
DJANGO_BASE_FRONTEND_URL=https://jangubi.thenexcom.com

# Sessions/JWT (web + mobile)
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_NAME=sessionid
SESSION_COOKIE_SAMESITE=Lax
CSRF_USE_SESSIONS=True

JWT_EXPIRATION_DELTA_SECONDS=604800
JWT_AUTH_COOKIE=jwt
JWT_AUTH_COOKIE_SAMESITE=Lax
JWT_AUTH_HEADER_PREFIX=Bearer

# Logging/Debug
DEBUG_TOOLBAR_ENABLED=False
LOGGING_FORMAT=json

# ==============================================================================
# Bucket / Stockage S3 (MinIO en local)
# ==============================================================================
# En local, on utilise le stockage "local" par défaut.
# Décommentez et configurez si vous passez en mode S3 (FILE_UPLOAD_STORAGE=s3)
FILE_UPLOAD_STRATEGY=standard
FILE_UPLOAD_STORAGE=s3
FILE_MAX_SIZE=10485760

AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=jangubi-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_PRESIGNED_EXPIRY=10
AWS_S3_CUSTOM_DOMAIN=

# ==============================================================================
# Docker Compose Config (utilisées par les services db et minio)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_DB=jangubi
POSTGRES_USER=jangubi_user
POSTGRES_PASSWORD=jangubi_pass

# ==============================================================================
# Sentry (désactivé en local, laisser vide)
# ==============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ==============================================================================
# Gemini / RAG
# ==============================================================================
EMBEDDING_PROVIDER=local
PGVECTOR_ENABLED=True

# Admin
ADMIN_EMAIL=kamalmoustoifa@gmail.com
ADMIN_PASSWORD=p@ssw0rdH@shed
# --- Keycloak (lot L3, ADR-004) -------------------------------------------------
# Laisser KEYCLOAK_ENABLED=false tant que le realm n'est pas déployé ; passer
# LEGACY_JWT_ENABLED=false seulement quand le front utilise Auth.js (Keycloak).
KEYCLOAK_ENABLED=false
LEGACY_JWT_ENABLED=true
KEYCLOAK_SERVER_URL=https://auth.example.org
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=jangubi
KEYCLOAK_AUDIENCE=jangubi-api
KEYCLOAK_ALLOWED_CLIENTS=jangubi-web
KEYCLOAK_ADMIN_CLIENT_ID=jangubi-admin-sync
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_REQUIRE_MFA_FOR_STAFF=true
