PYTHONBREAKPOINT=ipdb.set_trace
SENTRY_DSN=""

EMAIL_FROM_ADDRESS=noreply@jangubi.sn
ADMIN_ACCOUNT_EXPIRY_DAYS=7

# Destinataire interne du formulaire « Pour les paroisses » et quota par IP
CONTACT_EMAIL=contact@numerisen.sn
CONTACT_THROTTLE_RATE=5/hour

# Dons et quêtes (ADR-017) — agrégateur factice en dev ; aucun paiement réel
DONATIONS_PROVIDER=fake
DONATIONS_RETURN_URL=http://localhost:3000/dons/retour
DONATIONS_CALLBACK_BASE_URL=http://localhost:8001
DONATIONS_FEE_RATE_BP=200
DONATIONS_CHECKOUT_THROTTLE_RATE=20/hour

# Email sending — valeurs de dev (MailHog)
EMAIL_SENDING_STRATEGY=mailhog
MAILHOG_HOST=mailpit
MAILHOG_PORT=1025

FILE_UPLOAD_STRATEGY="direct" # pass-thru
FILE_UPLOAD_STORAGE="local" # s3

AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME=""
AWS_S3_CUSTOM_DOMAIN=""

# URL par laquelle le NAVIGATEUR atteint MinIO (jamais le nom d'hôte Docker
# interne). En dev, l'API MinIO est publiée sur le port 9002 de l'hôte.
# En production, mettre le domaine public (ex. https://s3.exemple.app).
# Laissé vide, le code retombe sur AWS_S3_ENDPOINT_URL.
MINIO_PUBLIC_URL="http://localhost:9002"
# Audios du chapelet : bucket dédié en lecture anonyme en LOCAL seulement
# (recette/production : ROSARY_AUDIO_BUCKET=jangubi-<env>, ROSARY_AUDIO_LOCATION=rosary-audio, PUBLIC=false).
ROSARY_AUDIO_BUCKET=rosary-audio
ROSARY_AUDIO_PUBLIC=True

DJANGO_GOOGLE_OAUTH2_CLIENT_ID=""
DJANGO_GOOGLE_OAUTH2_CLIENT_SECRET=""
DJANGO_GOOGLE_OAUTH2_PROJECT_ID=""

# Recherche et recommandations : plein texte PostgreSQL, sans IA ni modèle (ADR-018).
# Aucun réglage à fournir.

# --- Keycloak (lot L3, ADR-004) -------------------------------------------------
# Keycloak est la seule authentification (ADR-004). KEYCLOAK_ENABLED ne commande que la
# synchronisation avec l'API d'administration (rôle staff, suppression de compte).
KEYCLOAK_ENABLED=true
KEYCLOAK_SERVER_URL=http://localhost:8180
# URL vue depuis le conteneur django (JWKS, API d'administration)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=jangubi
KEYCLOAK_AUDIENCE=jangubi-api
KEYCLOAK_ALLOWED_CLIENTS=jangubi-web,jangubi-mobile
KEYCLOAK_ADMIN_CLIENT_ID=jangubi-admin-sync
# Générer : openssl rand -hex 32 (jamais de valeur par défaut : ce compte peut attribuer des rôles)
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_REQUIRE_MFA_FOR_STAFF=true
KEYCLOAK_DB_PASSWORD=keycloak
# URI de rappel EXACTE d'Auth.js (jamais de joker)
# Rappel OIDC du web (Next, route /auth/callback) ; l'ancien rappel Auth.js reste accepté
# pendant la transition (KC_WEB_LEGACY_REDIRECT_URI). Redirections exactes, jamais de joker.
KC_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
KC_WEB_LEGACY_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
KC_MOBILE_REDIRECT_URI=sn.numerisen.jangubi://oauth
KC_WEB_POST_LOGOUT_URI=http://localhost:3000/
KC_WEB_ORIGIN=http://localhost:3000

# La Parole (ADR-008) : "aelf" seulement avec l'accord écrit de l'AELF
LITURGY_SOURCE=crampon_refs
LITURGY_ZONE=afrique
# Édition biblique servie ; crampon1923 une fois la Crampon importée
BIBLE_EDITION=

# Admin Django (sans MFA) : fermée par défaut en production
DJANGO_ADMIN_ENABLED=false
DJANGO_ADMIN_URL=admin/
REGISTER_THROTTLE_RATE=10/hour
# Version en vigueur des CGU et de la politique (EF-CONF-01)
CONSENT_CURRENT_VERSION=2026-09

# Administration des comptes synchronisée avec Keycloak (docs/ADMIN-KEYCLOAK.md)
KEYCLOAK_ADMIN_BACKEND=http
KEYCLOAK_EVENTS_POLL_ENABLED=true
KEYCLOAK_RECONCILE_MAX_DELETIONS=5
KEYCLOAK_ACTIONS_CLIENT_ID=jangubi-web
KEYCLOAK_ACTIONS_REDIRECT_URI=
# Option (SPI p2-inc keycloak-events requis) :
KEYCLOAK_WEBHOOK_ENABLED=false
KEYCLOAK_WEBHOOK_SECRET=
