PYTHONBREAKPOINT=ipdb.set_trace
SENTRY_DSN=""

EMAIL_FROM_ADDRESS=noreply@jangubi.sn
ADMIN_ACCOUNT_EXPIRY_DAYS=7

# Email sending — valeurs de dev (MailHog)
EMAIL_SENDING_STRATEGY=mailhog
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

FILE_UPLOAD_STRATEGY="direct" # pass-thru
FILE_UPLOAD_STORAGE="local" # s3

AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME=""
AWS_S3_CUSTOM_DOMAIN=""

# URL par laquelle le NAVIGATEUR atteint MinIO (jamais le nom d'hôte Docker
# interne). En dev, l'API MinIO est publiée sur le port 9002 de l'hôte.
# En production, mettre le domaine public (ex. https://s3.exemple.app).
# Laissé vide, le code retombe sur AWS_S3_ENDPOINT_URL.
MINIO_PUBLIC_URL="http://localhost:9002"

DJANGO_GOOGLE_OAUTH2_CLIENT_ID=""
DJANGO_GOOGLE_OAUTH2_CLIENT_SECRET=""
DJANGO_GOOGLE_OAUTH2_PROJECT_ID=""

# --- Recherche sémantique & RAG (GRATUIT) ---------------------------------
# Par défaut : recherche lexicale (FTS) + RAG extractif. Aucun coût.
# Pour ACTIVER la recherche sémantique vectorielle (embeddings locaux gratuits) :
#   1) EMBEDDING_PROVIDER=local et PGVECTOR_ENABLED=True
#   2) (re)indexer les embeddings (compute_embeddings_task par livre, ou re-seed)
# Le 1er usage télécharge le modèle (~1 Go) dans FASTEMBED_CACHE_DIR.
EMBEDDING_PROVIDER=local
PGVECTOR_ENABLED=True
# FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# FASTEMBED_CACHE_DIR=/app/.cache/fastembed

# Génération LLM (OPTIONNELLE — le RAG marche sans). Laisser off pour rester gratuit.
RAG_GENERATION_ENABLED=False
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Keycloak (lot L3, ADR-004) -------------------------------------------------
# Bascule par réglage : KEYCLOAK_ENABLED active les jetons Keycloak ;
# LEGACY_JWT_ENABLED=false retire l'ancien JWT (une fois le front passé sur Auth.js).
KEYCLOAK_ENABLED=false
LEGACY_JWT_ENABLED=true
KEYCLOAK_SERVER_URL=http://localhost:8180
# URL vue depuis le conteneur django (JWKS, API d'administration)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=jangubi
KEYCLOAK_AUDIENCE=jangubi-api
KEYCLOAK_ALLOWED_CLIENTS=jangubi-web
KEYCLOAK_ADMIN_CLIENT_ID=jangubi-admin-sync
# Générer : openssl rand -hex 32 (jamais de valeur par défaut : ce compte peut attribuer des rôles)
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_REQUIRE_MFA_FOR_STAFF=true
KEYCLOAK_DB_PASSWORD=keycloak
# URI de rappel EXACTE d'Auth.js (jamais de joker)
KC_WEB_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
KC_WEB_POST_LOGOUT_URI=http://localhost:3000/
KC_WEB_ORIGIN=http://localhost:3000
