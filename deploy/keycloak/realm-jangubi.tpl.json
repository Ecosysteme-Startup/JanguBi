{
  "realm": "jangubi",
  "displayName": "Jàngu Bi",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "passwordPolicy": "length(10) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and notEmail(undefined)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "attributes": {
    "frontendUrl": "${KC_URL_PUBLIQUE}",
    "adminEventsExpiration": "7776000"
  },
  "browserFlow": "browser-mfa",
  "roles": {
    "realm": [
      {
        "name": "fidele",
        "description": "Fidèle (rôle par défaut)"
      },
      {
        "name": "staff",
        "description": "Titulaire d'au moins un office actif (synchronisé par l'application, MFA exigée)"
      },
      {
        "name": "platform_admin",
        "description": "Administration Numerisen (attribué à la main, MFA exigée)"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-jangubi",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "fidele",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-jangubi",
    "composite": true
  },
  "clients": [
    {
      "clientId": "jangubi-web",
      "name": "Jàngu Bi (web)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${KC_JANGUBI_WEB_URL}/auth/callback",
        "${KC_JANGUBI_WEB_URL}/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "${KC_JANGUBI_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_JANGUBI_WEB_URL}/"
      },
      "protocolMappers": [
        {
          "name": "audience jangubi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jangubi-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "phone_number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "phone",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birthdate",
            "claim.name": "birthdate",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ],
      "baseUrl": "${KC_JANGUBI_WEB_URL}",
      "rootUrl": "${KC_JANGUBI_WEB_URL}"
    },
    {
      "clientId": "jangubi-mobile",
      "name": "Jàngu Bi (app iOS et Android)",
      "description": "Client public natif : Authorization Code + PKCE S256, redirection exacte par schéma d'app (RFC 8252).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${KC_JANGUBI_MOBILE_REDIRECT_URI}"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_JANGUBI_MOBILE_REDIRECT_URI}",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "audience jangubi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jangubi-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "phone_number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "phone",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birthdate",
            "claim.name": "birthdate",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "jangubi-api",
      "name": "Jàngu Bi (API, audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "jangubi-admin-sync",
      "name": "Jàngu Bi (synchronisation des comptes)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_JANGUBI_ADMIN_SYNC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "description": "Compte de service de l'API : synchronisation bidirectionnelle des comptes (création, mise à jour, désactivation, lecture des événements de connexion)."
    }
  ],
  "users": [
    {
      "username": "service-account-jangubi-admin-sync",
      "enabled": true,
      "serviceAccountClientId": "jangubi-admin-sync",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-events",
          "view-realm"
        ]
      }
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "43200"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "43200"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Navigateur : mot de passe puis OTP dès qu'il est configuré (obligatoire pour staff et platform_admin via l'action requise CONFIGURE_TOTP)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-mfa forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Identifiants puis second facteur",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-pwd",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-mfa otp",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa otp",
      "description": "OTP si l'utilisateur l'a configuré",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "loginTheme": "jangubi",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"multivalued\": false}, {\"name\": \"phone\", \"displayName\": \"${phoneLabel}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"max\": 20}, \"pattern\": {\"pattern\": \"^\\\\s*(?:\\\\+?221[\\\\s.-]?)?7[05-8](?:[\\\\s.-]?\\\\d){7}\\\\s*$\", \"error-message\": \"phoneInvalid\"}}, \"annotations\": {\"inputType\": \"html5-tel\", \"inputTypePlaceholder\": \"${phonePlaceholder}\", \"inputHelperTextBefore\": \"${phonePrefix}\", \"inputHelperTextAfter\": \"${phoneHelp}\", \"autocomplete\": \"tel-national\", \"inputTypeMaxlength\": \"20\"}, \"multivalued\": false}, {\"name\": \"birthdate\", \"displayName\": \"${birthdateLabel}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"iso-date\": {}}, \"annotations\": {\"inputType\": \"html5-date\", \"autocomplete\": \"bday\"}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "smtpServer": {
    "host": "${KC_SMTP_HOTE}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_EXPEDITEUR}",
    "fromDisplayName": "Jàngu Bi",
    "replyTo": "${KC_SMTP_REPONDRE_A}",
    "auth": "${KC_SMTP_AUTH}",
    "user": "${KC_SMTP_UTILISATEUR}",
    "password": "${KC_SMTP_MOT_DE_PASSE}",
    "ssl": "${KC_SMTP_SSL}",
    "starttls": "${KC_SMTP_STARTTLS}"
  },
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "LOGOUT",
    "UPDATE_PROFILE",
    "UPDATE_EMAIL",
    "VERIFY_EMAIL",
    "UPDATE_PASSWORD",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "DELETE_ACCOUNT",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL"
  ]
}
