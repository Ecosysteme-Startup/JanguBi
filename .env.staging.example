# ==============================================================================
# RECETTE (staging) — modèle de .env.staging (docs/RECETTE.md).
#   cp .env.staging.example .env.staging
# puis remplacer chaque CHANGE_ME. .env.staging n'est jamais versionné.
# Aucune donnée réelle en recette : comptes et paroisse de démonstration seulement.
# ==============================================================================

DJANGO_SETTINGS_MODULE=config.django.staging
SENTRY_ENVIRONMENT=staging
SENTRY_DSN=

# --- Secrets (générer : python -c "import secrets; print(secrets.token_hex(32))") ------------
SECRET_KEY=CHANGE_ME
# Distincte de SECRET_KEY, jamais rotée (chiffrement des conversations pastorales).
MESSAGING_ENCRYPTION_KEY=CHANGE_ME

# --- Services de la pile (noms des services de docker-compose.staging.yml) ------------------
# Les mêmes valeurs servent au conteneur Postgres (POSTGRES_*) et à DATABASE_URL.
POSTGRES_DB=jangubi
POSTGRES_USER=jangubi
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://jangubi:CHANGE_ME@db:5432/jangubi

REDIS_URL=redis://redis:6379/1

RABBITMQ_USER=jangubi
RABBITMQ_PASSWORD=CHANGE_ME
CELERY_BROKER_URL=amqp://jangubi:CHANGE_ME@rabbitmq:5672//

# --- Accès HTTP --------------------------------------------------------------------------------
# Hôte public de l'API (sans schéma) + nom du service interne.
ALLOWED_HOSTS=localhost,127.0.0.1,django
# Fronts de recette autorisés (origines exactes, schéma compris). Jamais CORS_ALLOW_ALL_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_BASE_BACKEND_URL=http://localhost:8100
DJANGO_BASE_FRONTEND_URL=http://localhost:3000
# 0 en accès direct au port 8100 ; 1 derrière un proxy TLS (Traefik, Caddy, nginx).
NUM_PROXIES=0
# Derrière un proxy TLS : passer ces quatre réglages (True, True, True, 3600).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
LOGGING_FORMAT=json
DJANGO_ADMIN_ENABLED=false

# --- Stockage objet (MinIO de la pile) -------------------------------------------------------
MINIO_ROOT_USER=jangubi
MINIO_ROOT_PASSWORD=CHANGE_ME
FILE_UPLOAD_STRATEGY=standard
FILE_UPLOAD_STORAGE=s3
AWS_S3_ACCESS_KEY_ID=jangubi
AWS_S3_SECRET_ACCESS_KEY=CHANGE_ME
AWS_STORAGE_BUCKET_NAME=jangubi-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_PRESIGNED_EXPIRY=600
# URL par laquelle le NAVIGATEUR et l'app atteignent MinIO (URL présignées, lecture audio).
MINIO_PUBLIC_URL=http://localhost:9100

# --- Sonothèque ---------------------------------------------------------------------------------
# Pas de CDN en recette : lecture par URL MinIO présignée.
AUDIO_CDN_BASE_URL=
AUDIO_CDN_SIGNING_SECRET=

# --- Keycloak (ADR-004) --------------------------------------------------------------------------
KEYCLOAK_ENABLED=true
# URL publique (émetteur des jetons) — la même que KC_HOSTNAME du conteneur keycloak.
KEYCLOAK_SERVER_URL=http://localhost:8280
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=jangubi
KEYCLOAK_AUDIENCE=jangubi-api
KEYCLOAK_ALLOWED_CLIENTS=jangubi-web,jangubi-mobile
KEYCLOAK_ADMIN_CLIENT_ID=jangubi-admin-sync
# openssl rand -hex 32 — importé dans le realm au premier démarrage de Keycloak.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_REQUIRE_MFA_FOR_STAFF=true
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
# Rappels OIDC exacts des fronts de recette (jamais de joker).
KC_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
KC_WEB_LEGACY_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
KC_MOBILE_REDIRECT_URI=sn.numerisen.jangubi://oauth
KC_WEB_POST_LOGOUT_URI=http://localhost:3000/
KC_WEB_ORIGIN=http://localhost:3000
JANGUBI_API_URL=http://localhost:8100/api/v1
# Mot de passe commun des comptes de démonstration (infra/keycloak/seed-demo-users.sh).
KC_DEMO_PASSWORD=CHANGE_ME

# --- E-mails : tout est capturé par Mailpit (http://localhost:8026) --------------------------
EMAIL_SENDING_STRATEGY=mailhog
MAILHOG_HOST=mailpit
MAILHOG_PORT=1025
EMAIL_FROM_ADDRESS=noreply@jangubi.sn
CONTACT_EMAIL=contact@numerisen.sn

# --- Dons (ADR-017) : agrégateur FACTICE, aucun paiement réel -------------------------------
DONATIONS_PROVIDER=fake
DONATIONS_FAKE_SECRET=CHANGE_ME
DONATIONS_PAYLOAD_KEY=CHANGE_ME
DONATIONS_RETURN_URL=http://localhost:3000/dons/retour
DONATIONS_CALLBACK_BASE_URL=http://localhost:8100

# --- Temps réel ------------------------------------------------------------------------------
# Push désactivé par défaut en recette (renseigner FCM_* / APNS_* pour le tester).
PUSH_ENABLED=false
METRICS_ENABLED=false

# --- La Parole, RAG ----------------------------------------------------------------------------
LITURGY_SOURCE=crampon_refs
LITURGY_ZONE=afrique
BIBLE_EDITION=
EMBEDDING_PROVIDER=local
PGVECTOR_ENABLED=True
RAG_GENERATION_ENABLED=False
CONSENT_CURRENT_VERSION=2026-09
